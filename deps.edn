{:paths ["src" "resources"]
 :deps {io.github.kotoba-lang/technology {:git/url "https://github.com/kotoba-lang/technology.git"
                                    :git/sha "6dff7c1f7a10e8f9f7a05ea8c4c1731063597e79"}
        ;; The workspace's portable .cljc SHA-256, in place of
        ;; java.security.MessageDigest. See kotoba.occupation's docstring:
        ;; a :cljs reader conditional over node:crypto would have worked
        ;; under nbb and not in a browser, and would have left two hash
        ;; implementations that can disagree about ids already minted.
        io.github.kotoba-lang/org-nist-sha2 {:git/url "https://github.com/kotoba-lang/org-nist-sha2.git"
                                             :git/sha "3b4f7e93eff2c438c758383bab440b6f35627e31"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}